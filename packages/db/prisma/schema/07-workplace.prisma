// ============================================================================
//  KEKA — Workplace: engagement, assets, documents, training, meetings
// ============================================================================
//  Consolidated from the reference HRM products: announcements and awards
//  (HRM OS), assets with depreciation and contracts (HRM), documents with
//  acknowledgement tracking, training/LMS, and meetings with minutes.
// ============================================================================

// ---------------------------------------------------------------------------
//  ANNOUNCEMENTS
// ---------------------------------------------------------------------------

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

model Announcement {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title     String
  body      String
  bannerUrl String?
  status    AnnouncementStatus @default(DRAFT)

  /// Audience filters. Empty means everyone.
  /// { departmentIds: [], locationIds: [], businessUnitIds: [], workerTypeIds: [],
  ///   excludeOnNotice: bool }
  audience Json?

  publishAt     DateTime?
  expiresAt     DateTime?
  /// Employees must tick to confirm they have read it.
  requireAck    Boolean   @default(false)
  notifyByEmail Boolean   @default(false)
  isPinned      Boolean   @default(false)

  // --- Engage depth (34-engage-depth) ---
  /// null (no approval needed) | PENDING | APPROVED | REJECTED
  approvalStatus    String?
  workflowRequestId String?
  /// Emergency broadcast: skips approval, emails everyone, banner on every page.
  isEmergency       Boolean   @default(false)
  /// GENERAL | POLICY | LEADERSHIP | EVENT | IT | HR
  category          String?
  /// { "<lang>": { title, body } }
  translations      Json?
  lastReminderAt    DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads    AnnouncementRead[]
  /// Wall reactions on the announcement (15-engage).
  likes    WallLike[]
  comments WallComment[]

  @@index([tenantId, status, publishAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  viewedAt       DateTime  @default(now())
  acknowledgedAt DateTime?

  @@unique([announcementId, employeeId])
  @@index([employeeId])
  @@map("announcement_reads")
}

// ---------------------------------------------------------------------------
//  AWARDS AND RECOGNITION
// ---------------------------------------------------------------------------

enum AwardCadence {
  MONTHLY
  QUARTERLY
  ANNUAL
  SPOT
}

model AwardType {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  icon        String?
  color       String?
  cadence     AwardCadence @default(MONTHLY)
  /// A cash prize attached to the award, paid through payroll as an ad-hoc payment.
  cashAmount  Decimal?     @db.Decimal(18, 2)
  /// Reward points redeemed through a rewards partner.
  points      Int?
  isActive    Boolean      @default(true)

  createdAt DateTime @default(now())

  awards EmployeeAward[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("award_types")
}

model EmployeeAward {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  awardTypeId String
  awardType   AwardType @relation(fields: [awardTypeId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The period the award recognises, e.g. "2026-06" or "2026-Q2".
  period         String?
  awardedOn      DateTime
  citation       String?
  /// Set when a cash award is pushed into a payroll run.
  cashAmount     Decimal? @db.Decimal(18, 2)
  paidInRunId    String?
  certificateUrl String?

  nominatedBy String?
  approvedBy  String?
  isPublished Boolean @default(true)
  // --- Engage depth (34-engage-depth) ---
  programId    String?
  points       Int?
  revokedAt    DateTime?
  revokeReason String?

  createdAt DateTime @default(now())

  @@index([tenantId, awardedOn])
  @@index([employeeId])
  @@map("employee_awards")
}

/// Peer-to-peer praise, distinct from a formal award.
model Praise {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromEmployeeId String
  fromEmployee   Employee @relation("PraiseGiven", fields: [fromEmployeeId], references: [id], onDelete: Cascade)
  toEmployeeId   String
  toEmployee     Employee @relation("PraiseReceived", fields: [toEmployeeId], references: [id], onDelete: Cascade)

  /// Badge name, e.g. "Team Player", "Above and Beyond". Kept as the name copy
  /// even when badgeId is set.
  badge    String?
  message  String
  /// Visible on the organisation praise wall.
  isPublic Boolean @default(true)

  // --- Keka parity (15-engage) ---
  /// Configured badge; `badge` keeps the name copy.
  badgeId    String?
  badgeRef   PraiseBadge? @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  /// One WallPost(PRAISE) holds N Praise rows, one per recipient.
  wallPostId String?
  wallPost   WallPost?    @relation(fields: [wallPostId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([toEmployeeId])
  @@index([wallPostId])
  @@index([badgeId])
  @@map("praises")
}

// ---------------------------------------------------------------------------
//  ASSETS
// ---------------------------------------------------------------------------

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
  /// Withheld from assignment without being retired.
  UNAVAILABLE
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
  UNUSABLE
}

/// Snapshot of AssetType.requireAck taken at assignment.
enum AssetAckStatus {
  NOT_APPLICABLE
  PENDING
  ACKNOWLEDGED
}

enum AssetRequestType {
  NEW_ASSET
  REPLACEMENT
  RETURN
}

model AssetCategory {
  id               String  @id @default(cuid())
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  /// Straight-line depreciation over this many months. Null means none.
  usefulLifeMonths Int?
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())

  types    AssetType[]
  requests AssetRequest[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("asset_categories")
}

model AssetType {
  id          String        @id @default(cuid())
  categoryId  String
  category    AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  make        String?
  model       String?
  /// Requires employee acknowledgement on assignment.
  requireAck  Boolean       @default(true)
  description String?
  /// laptop | desktop | monitor | phone | tablet | chair | card | network | other
  icon        String        @default("other")
  isActive    Boolean       @default(true)

  createdAt DateTime @default(now())

  assets   Asset[]
  requests AssetRequest[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("asset_types")
}

/// Configurable asset ID series, mirroring the employee number series.
model AssetIdSeries {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String  @default("AST")
  digits     Int     @default(5)
  suffix     String  @default("")
  nextNumber Int     @default(1)
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("asset_id_series")
}

model Asset {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetTypeId String
  assetType   AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)

  /// Generated from an AssetIdSeries.
  assetTag     String
  serialNumber String?
  status       AssetStatus    @default(AVAILABLE)
  condition    AssetCondition @default(NEW)

  purchaseDate   DateTime?
  purchaseCost   Decimal?  @db.Decimal(18, 2)
  vendor         String?
  invoiceNumber  String?
  warrantyExpiry DateTime?
  /// Book value after depreciation, recomputed on demand.
  currentValue   Decimal?  @db.Decimal(18, 2)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes      String?

  // --- Keka parity (assets) ---
  /// Keka "Asset Name"; UI falls back to assetType.name.
  name              String?
  description       String?
  /// Required when status is IN_REPAIR | LOST | UNAVAILABLE | RETIRED.
  unavailableReason String?
  /// StoredFile id; documents are StoredFile rows with relatedType "Asset".
  imageFileId       String?
  customFields      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments AssetAssignment[]
  requests    AssetRequest[]
  events      AssetEvent[]

  /// Shared pool (33-cases-docs): pool assets are reserved, not assigned.
  poolId String?
  pool   AssetPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@index([assetTypeId])
  @@index([tenantId, locationId])
  @@index([tenantId, warrantyExpiry])
  @@map("assets")
}

model AssetAssignment {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  assignedOn   DateTime
  assignedBy   String?
  conditionOut AssetCondition @default(GOOD)

  /// Acknowledgement by the employee that they have received it.
  acknowledgedAt DateTime?

  returnedOn      DateTime?
  conditionIn     AssetCondition?
  /// Recovered from the employee, and flows into the F&F settlement.
  damageCharge    Decimal?        @db.Decimal(18, 2)
  damageNote      String?
  /// Set once the charge has been pushed to payroll or a settlement.
  chargeRecovered Boolean         @default(false)

  // --- Keka parity (assets) ---
  /// Snapshot of assetType.requireAck at assignment.
  ackStatus      AssetAckStatus @default(PENDING)
  ackRemindedAt  DateTime?
  ackRemindCount Int            @default(0)
  /// The request this assignment fulfils.
  requestId      String?        @unique
  request        AssetRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  /// Employee id of whoever recovered it.
  returnedBy     String?

  notes     String?
  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([employeeId, returnedOn])
  @@index([ackStatus])
  @@map("asset_assignments")
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

model AssetRequest {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Set once a specific asset is allocated against the request.
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  assetTypeId String?
  assetType   AssetType?         @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  reason      String
  status      AssetRequestStatus @default(PENDING)
  neededBy    DateTime?

  approvedBy   String?
  approvedAt   DateTime?
  rejectReason String?

  // --- Keka parity (assets) ---
  requestType  AssetRequestType       @default(NEW_ASSET)
  /// "Asset requested for" (free text).
  title        String?
  categoryId   String?
  category     AssetCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// REPLACEMENT/RETURN: asset currently held (plain id; assetId already relates Asset).
  heldAssetId  String?
  currentLevel Int                    @default(1)
  closedAt     DateTime?
  /// Employee id shown as "Action taken by".
  closedBy     String?
  approvals    AssetRequestApproval[]
  assignment   AssetAssignment?

  createdAt DateTime @default(now())

  @@index([tenantId, status])
  @@index([employeeId])
  @@index([tenantId, status, createdAt])
  @@map("asset_requests")
}

// ---------------------------------------------------------------------------
//  DOCUMENTS AND CONTRACTS
// ---------------------------------------------------------------------------

enum DocumentScope {
  /// Belongs to one employee.
  EMPLOYEE
  /// Organisation-wide policy document.
  ORGANISATION
}

model DocumentFolder {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  scope          DocumentScope @default(EMPLOYEE)
  /// Restricts access to explicitly permitted roles.
  isConfidential Boolean       @default(false)
  /// Role keys that may view, and separately edit.
  viewRoles      Json?
  editRoles      Json?

  createdAt DateTime @default(now())

  types        DocumentType[]
  documents    EmployeeDocument[]
  orgDocuments OrgDocument[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("document_folders")
}

model DocumentType {
  id       String         @id @default(cuid())
  folderId String
  folder   DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  name                String
  /// Single upload, or many of this type.
  allowMultiple       Boolean @default(false)
  isMandatory         Boolean @default(false)
  /// Routes to admin verification after upload.
  requireVerification Boolean @default(true)
  /// Prompts the employee for an expiry date.
  trackExpiry         Boolean @default(false)
  /// Employee may mark it as not applicable to them.
  allowNotApplicable  Boolean @default(false)

  createdAt DateTime @default(now())

  documents EmployeeDocument[]

  @@unique([folderId, name])
  @@index([folderId])
  @@map("document_types")
}

enum EmployeeDocumentStatus {
  PENDING_ON_EMPLOYEE
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  NOT_APPLICABLE
  EXPIRED
}

model EmployeeDocument {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  folderId       String?
  folder         DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  documentTypeId String?
  documentType   DocumentType?   @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)

  name     String
  fileUrl  String?
  fileSize Int?
  mimeType String?
  status   EmployeeDocumentStatus @default(PENDING_ON_EMPLOYEE)

  issuedOn  DateTime?
  expiresOn DateTime?

  uploadedBy   String?
  uploadedAt   DateTime?
  verifiedBy   String?
  verifiedAt   DateTime?
  rejectReason String?

  // --- Expiry and renewal (33-cases-docs) ---
  /// 0 none sent · 1 30-day notice · 2 7-day notice · 3 expired notice
  expiryNoticeStage  Int       @default(0)
  renewalRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([employeeId])
  @@index([expiresOn])
  @@map("employee_documents")
}

/// Organisation policy documents, with enforced acknowledgement.
model OrgDocument {
  id       String          @id @default(cuid())
  tenantId String
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folderId String?
  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  title         String
  description   String?
  fileUrl       String?
  version       String?
  effectiveFrom DateTime?
  requireAck    Boolean   @default(false)
  isPublished   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acknowledgements OrgDocumentAck[]

  @@index([tenantId])
  @@map("org_documents")
}

model OrgDocumentAck {
  id             String      @id @default(cuid())
  documentId     String
  document       OrgDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime    @default(now())

  @@unique([documentId, employeeId])
  @@index([employeeId])
  @@map("org_document_acks")
}

/// Letter and document generation templates with dynamic placeholders.
model DocumentTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  /// OFFER | CONFIRMATION | RELIEVING | APPOINTMENT | EXPERIENCE | WARNING | CUSTOM
  category       String  @default("CUSTOM")
  /// HTML body containing {{placeholders}}.
  body           String
  /// Placeholder keys the template uses, for validation before generation.
  placeholders   Json?
  /// Scope to specific legal entities. Empty means org-wide.
  legalEntityIds Json?
  /// Attached workflow: ACKNOWLEDGE | APPROVE | SIGN
  workflow       String?
  isArchived     Boolean @default(false)

  // --- Template governance (33-cases-docs) ---
  ownerUserId       String?
  /// DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
  approvalStatus    String    @default("APPROVED")
  approvedByUserId  String?
  approvedAt        DateTime?
  workflowRequestId String?
  version           Int       @default(1)
  nextReviewOn      DateTime?
  lastReviewedAt    DateTime?
  reviewRemindedAt  DateTime?
  /// Department ids the template may be used for; empty = all.
  departmentIds     Json?
  archivedAt        DateTime?
  archivedReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generated GeneratedDocument[]

  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@map("document_templates")
}

model GeneratedDocument {
  id         String           @id @default(cuid())
  templateId String
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Rendered HTML at the time of generation, so a later template edit does
  /// not rewrite history.
  renderedBody String
  fileUrl      String?
  /// PENDING_APPROVAL | PENDING_ACKNOWLEDGEMENT | PENDING_SIGNATURE | ISSUED |
  /// ACKNOWLEDGED | SIGNED | REJECTED | VOID
  status       String  @default("ISSUED")
  /// The template's workflow when this letter was generated, e.g. "APPROVE,SIGN".
  workflow     String?
  /// SHA-256 of renderedBody, checked again when the letter is signed.
  contentHash  String?

  issuedOn        DateTime  @default(now())
  issuedBy        String?
  /// User who generated it; an approver must be someone else.
  issuedByUserId  String?
  approvedBy      String?
  approvedAt      DateTime?
  decisionNote    String?
  acknowledgedAt  DateTime?
  signedAt        DateTime?
  /// What the employee typed as their name, and the drawn signature file.
  signerName      String?
  signatureFileId String?
  signedIp        String?
  signedUserAgent String?
  voidedAt        DateTime?
  voidReason      String?

  // --- Letter operations (33-cases-docs) ---
  letterNumber    String?
  validUntil      DateTime?
  batchId         String?
  /// EXIT_COMPLETED | SALARY_REVISION_APPLIED | CONFIRMED when auto-generated.
  triggerEvent    String?
  sentCount       Int       @default(1)
  lastSentAt      DateTime?

  @@index([employeeId])
  @@index([status])
  @@index([templateId])
  @@map("generated_documents")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  RENEWED
}

model EmployeeContract {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  contractNumber String?
  /// PERMANENT | FIXED_TERM | PROBATION | CONSULTANT | INTERNSHIP
  contractType   String         @default("FIXED_TERM")
  startDate      DateTime
  endDate        DateTime?
  status         ContractStatus @default(ACTIVE)

  /// Contracted annual value, which may differ from the payroll CTC.
  contractValue Decimal? @db.Decimal(18, 2)
  noticeDays    Int?
  fileUrl       String?
  terms         String?

  /// Chain when a contract is renewed rather than replaced.
  renewedFromId String?
  renewedFrom   EmployeeContract?  @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals      EmployeeContract[] @relation("ContractRenewal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([employeeId])
  @@index([endDate])
  @@map("employee_contracts")
}

// ---------------------------------------------------------------------------
//  HR ACTIVITIES
// ---------------------------------------------------------------------------

enum HrActivityType {
  PROMOTION
  TRANSFER
  WARNING
  COMPLAINT
  WORK_TRIP
  TERMINATION
  RESIGNATION
  APPRECIATION
  SALARY_REVISION
}

/// A timeline of discrete HR events, distinct from the effective-dated job
/// record. A warning or a work trip is an event, not a position change.
model HrActivity {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        HrActivityType
  title       String
  description String?
  occurredOn  DateTime

  /// Promotion and transfer carry from/to values.
  fromValue   String?
  toValue     String?
  /// Work trip fields.
  tripFrom    DateTime?
  tripTo      DateTime?
  destination String?
  /// Warning severity: MINOR | MAJOR | FINAL
  severity    String?

  attachmentUrl String?
  /// Links to the effective-dated job record where one was created.
  jobRecordId   String?

  /// Ops depth: PENDING while an activity type that needs approval waits; APPROVED | REJECTED.
  approvalStatus String?
  editedBy       String?
  editedAt       DateTime?

  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([tenantId, type, occurredOn])
  @@index([employeeId, occurredOn])
  @@map("hr_activities")
}

// ---------------------------------------------------------------------------
//  TRAINING
// ---------------------------------------------------------------------------

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnrolmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
  WITHDRAWN
}

/// Lifecycle of a self-paced COURSE built in Learn. Null for PROGRAMME rows.
enum CourseState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model TrainingType {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// INTERNAL | EXTERNAL | ONLINE | CERTIFICATION
  mode        String  @default("INTERNAL")
  isActive    Boolean @default(true)

  createdAt DateTime          @default(now())
  programs  TrainingProgram[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("training_types")
}

model TrainingProgram {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainingTypeId String
  trainingType   TrainingType @relation(fields: [trainingTypeId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  trainer       String?
  /// Cost per participant, for training budget reporting.
  costPerHead   Decimal?       @db.Decimal(18, 2)
  venue         String?
  startDate     DateTime?
  endDate       DateTime?
  durationHours Decimal?       @db.Decimal(9, 2)
  maxSeats      Int?
  status        TrainingStatus @default(PLANNED)
  /// Skills this programme develops, awarded on completion.
  skills        Json?
  materialUrl   String?

  // --- Keka parity: Learn (19-perform-learn) ---
  /// PROGRAMME (scheduled, instructor-led — all rows today) | COURSE (self-paced, built in Learn)
  format      String       @default("PROGRAMME")
  courseState CourseState?
  category    String?
  authorId    String?
  author      Employee?    @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  selfEnrol   Boolean      @default(true)
  /// Drives the compliance tab instead of trainingType.mode.
  isMandatory Boolean      @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrolments TrainingEnrolment[]
  sections   CourseSection[]
  modules    CourseModule[]

  @@index([tenantId, status])
  @@index([tenantId, format, courseState])
  @@map("training_programs")
}

model TrainingEnrolment {
  id         String          @id @default(cuid())
  programId  String
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  status          EnrolmentStatus @default(ASSIGNED)
  progressPercent Int             @default(0)
  score           Decimal?        @db.Decimal(9, 2)
  completedAt     DateTime?
  certificateUrl  String?
  feedback        String?

  assignedAt DateTime @default(now())
  assignedBy String?

  /// Learn: per-module completion and assessment attempts. For COURSE rows
  /// progressPercent and score are derived from these.
  moduleProgress ModuleProgress[]
  attempts       AssessmentAttempt[]

  @@unique([programId, employeeId])
  @@index([employeeId, status])
  @@map("training_enrolments")
}

// ---------------------------------------------------------------------------
//  MEETINGS
// ---------------------------------------------------------------------------

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MeetingRoom {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  locationId String?
  capacity   Int?
  /// Projector, video conferencing, whiteboard.
  facilities Json?
  isActive   Boolean @default(true)

  createdAt DateTime  @default(now())
  meetings  Meeting[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("meeting_rooms")
}

model Meeting {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId   String?
  room     MeetingRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  title       String
  /// REVIEW | ONE_ON_ONE | STANDUP | INTERVIEW | TOWN_HALL | OTHER
  meetingType String        @default("OTHER")
  agenda      String?
  startsAt    DateTime
  endsAt      DateTime
  /// Set for a video meeting rather than a room.
  meetingUrl  String?
  status      MeetingStatus @default(SCHEDULED)

  /// Minutes recorded after the meeting. For 1:1s this holds the SHARED notes.
  minutes     String?
  organiserId String?

  // --- Keka parity: 1:1 meetings (19-perform-learn) ---
  /// "Career track", "Weekly check-in" — feeds the AI agenda.
  purpose     String?
  /// NONE | WEEKLY | BIWEEKLY | MONTHLY. Occurrences share seriesId.
  recurrence  String                 @default("NONE")
  seriesId    String?
  templateId  String?
  template    MeetingAgendaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// { summary: string, decisions: string[] } — from agenda, talking points, shared notes only.
  aiSummary   Json?
  aiSummaryAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees     MeetingAttendee[]
  actionItems   MeetingActionItem[]
  talkingPoints MeetingTalkingPoint[]
  privateNotes  MeetingPrivateNote[]

  @@index([tenantId, startsAt])
  @@index([roomId, startsAt])
  @@index([tenantId, meetingType, startsAt])
  @@index([seriesId])
  @@map("meetings")
}

model MeetingAttendee {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// REQUIRED | OPTIONAL
  attendance String   @default("REQUIRED")
  /// PENDING | ACCEPTED | DECLINED | TENTATIVE
  response   String   @default("PENDING")
  attended   Boolean?

  @@unique([meetingId, employeeId])
  @@index([employeeId])
  @@map("meeting_attendees")
}

model MeetingActionItem {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  description String
  ownerId     String?
  owner       Employee? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  /// OPEN | IN_PROGRESS | DONE | CANCELLED
  status      String    @default("OPEN")
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([meetingId])
  @@index([ownerId, status])
  @@map("meeting_action_items")
}
