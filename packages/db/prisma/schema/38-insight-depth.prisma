  config      Json
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("insight_cycle_templates")
}

/// The rating description library: a named scale with a label and a
/// description for every point.
model InsightRatingScale {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// [{ value, label, description }]
  points    Json
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("insight_rating_scales")
}

model InsightCalibrationNote {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId      String
  employeeId   String?
  body         String
  tags         String[] @default([])
  authorUserId String
  createdAt    DateTime @default(now())

  @@index([tenantId, cycleId])
  @@map("insight_calibration_notes")
}

model InsightReviewReopen {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewId          String
  cycleId           String
  employeeId        String
  reason            String
  previousStatus    String
  /// PENDING | APPROVED | REJECTED | WITHDRAWN
  status            String    @default("PENDING")
  requestedBy       String
  workflowRequestId String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([tenantId, status])
  @@index([reviewId])
  @@map("insight_review_reopens")
}

/// The performance exception queue: reviews that need a human look.
model InsightPerfException {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId    String
  reviewId   String
  employeeId String
  /// OVERDUE | SELF_GAP | NO_REASON | NO_GOALS | OUT_OF_BAND | MISSING_MANAGER
  kind       String
  detail     String
  /// OPEN | RESOLVED | DISMISSED
  status     String    @default("OPEN")
  note       String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([reviewId, kind])
  @@index([tenantId, status])
  @@map("insight_perf_exceptions")
}

// ---------------------------------------------------------------------------
//  OKRs
// ---------------------------------------------------------------------------

/// A link between two objectives that are not parent and child.
model InsightGoalLink {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromGoalId String
  toGoalId   String
  /// CONTRIBUTES_TO | DEPENDS_ON | BLOCKS | RELATED
  kind       String
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([fromGoalId, toGoalId, kind])
  @@index([tenantId])
  @@index([toGoalId])
  @@map("insight_goal_links")
}

model InsightOkrSetting {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// New goals wait for approval (manager for individual, goal admin otherwise).
  requireApproval Boolean  @default(false)
  /// WEEKLY | BIWEEKLY | MONTHLY
  defaultCadence  String   @default("MONTHLY")
  /// Days past the cadence before a check-in counts as overdue.
  graceDays       Int      @default(3)
  updatedAt       DateTime @updatedAt

  @@map("insight_okr_settings")
}

/// Closing out a goal period: every goal is scored final and snapshotted.
model InsightOkrCloseout {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeframe         String
  /// PENDING | APPROVED | REJECTED | WITHDRAWN
  status            String    @default("PENDING")
  requestedBy       String
  workflowRequestId String?
  /// { goals, completed, missed, averageProgress }
  summary           Json?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())

  @@index([tenantId, timeframe])
  @@map("insight_okr_closeouts")
}

model InsightGoalSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  closeoutId   String?
  label        String
  goalId       String
  title        String
  level        String
  ownerName    String?
  progress     Decimal  @db.Decimal(9, 2)
  status       String
  targetValue  Decimal  @db.Decimal(18, 2)
  currentValue Decimal  @db.Decimal(18, 2)
  takenAt      DateTime @default(now())

  @@index([tenantId, label])
  @@index([goalId])
  @@map("insight_goal_snapshots")
}

// ---------------------------------------------------------------------------
//  CONTINUOUS FEEDBACK
// ---------------------------------------------------------------------------

model InsightFeedbackTopic {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([tenantId, name])
  @@map("insight_feedback_topics")
}

model InsightFeedbackFollowUp {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedbackId      String
  ownerEmployeeId String
  title           String
  dueDate         DateTime
  /// OPEN | DONE | CANCELLED
  status          String    @default("OPEN")
  createdBy       String?
  doneAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, status])
  @@index([feedbackId])
  @@map("insight_feedback_followups")
}

/// When feedback is escalated, and to whom.
model InsightFeedbackRule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// NEGATIVE | KEYWORD | TOPIC
  trigger   String
  keyword   String?
  topicId   String?
  /// HR | MANAGER | SKIP_MANAGER
  notify    String   @default("HR")
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@map("insight_feedback_rules")
}

model InsightFeedbackEscalation {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId          String
  feedbackId      String
  notifiedUserIds String[]  @default([])
  /// OPEN | RESOLVED
  status          String    @default("OPEN")
  resolutionNote  String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@unique([ruleId, feedbackId])
  @@index([tenantId, status])
  @@map("insight_feedback_escalations")
}

// ---------------------------------------------------------------------------
//  PIP & COACHING
// ---------------------------------------------------------------------------

model InsightPipTemplate {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// PIP | COACHING
  kind             String   @default("PIP")
  name             String
  /// PIP: the reason; COACHING: the focus area.
  reason           String?
  /// PIP objectives / coaching goals, one per line.
  objectives       String?
  durationDays     Int      @default(60)
  /// [{ title, offsetDays }]
  milestones       Json?
  checklist        String[] @default([])
  /// Coaching: days between sessions.
  sessionEveryDays Int?
  isActive         Boolean  @default(true)
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, kind, name])
  @@map("insight_pip_templates")
}

model InsightPipSetting {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  minTenureDays        Int      @default(90)
  /// Only when the last final rating is at most this (null = any rating).
  maxRating            Decimal? @db.Decimal(9, 2)
  blockProbation       Boolean  @default(true)
  blockNotice          Boolean  @default(true)
  /// A plan cannot close until its required checklist items are done.
  requireChecklist     Boolean  @default(true)
  defaultChecklist     String[] @default([])
  /// Remind coaches when a coaching plan has had no session for this long.
  coachingReminderDays Int      @default(14)
  updatedAt            DateTime @updatedAt

  @@map("insight_pip_settings")
}

model InsightPipObjective {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipId     String
  title     String
  measure   String?
  target    String?
  weight    Int      @default(1)
  /// OPEN | MET | NOT_MET
  status    String   @default("OPEN")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipId])
  @@map("insight_pip_objectives")
}

model InsightPipEvidence {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipId     String
  title     String
  note      String?
  /// DOCUMENT | OBSERVATION | EMAIL | OTHER
  kind      String   @default("DOCUMENT")
  fileId    String?
  addedBy   String?
  createdAt DateTime @default(now())

  @@index([pipId])
  @@map("insight_pip_evidence")
}

model InsightPipChecklistItem {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipId    String
  label    String
  required Boolean   @default(true)
  position Int       @default(0)
  doneAt   DateTime?
  doneBy   String?
  note     String?

  @@index([pipId])
  @@map("insight_pip_checklist_items")
}

/// An observed behaviour, rated 1-5, during a PIP or a coaching plan.
model InsightBehaviorLog {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  pipId          String?
  coachingPlanId String?
  behaviour      String
  rating         Int
  note           String?
  observedOn     DateTime
  observedBy     String?
  createdAt      DateTime @default(now())

  @@index([tenantId, employeeId])
  @@map("insight_behavior_logs")
}

/// Extension, escalation or check-in sign-off of a PIP, decided through a workflow.
model InsightPipRequest {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipId             String
  /// EXTENSION | ESCALATION | CHECKIN_SIGNOFF
  kind              String
  days              Int?
  checkInId         String?
  reason            String
  /// PENDING | APPROVED | REJECTED | WITHDRAWN
  status            String    @default("PENDING")
  requestedBy       String
  workflowRequestId String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([tenantId, status])
  @@index([pipId])
  @@map("insight_pip_requests")
}
