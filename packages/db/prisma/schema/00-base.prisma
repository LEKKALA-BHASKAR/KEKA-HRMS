/// Org-wide visibility restriction (Teardown Part 06).
/// NOTE the documented combining rule: effective access =
///   scope-of-privilege UNION scope-of-visibility.
/// An unscoped role therefore sees across all legal entities regardless of this.
/// This is a directory-visibility control, NOT a hard data partition.
model TenantVisibilitySetting {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  restrictByLegalEntity   Boolean @default(false)
  restrictByBusinessUnit  Boolean @default(false)
  /// Managers and their direct reports retain mutual visibility across boundaries.
  managerReporteeOverride Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("tenant_visibility_settings")
}

enum TwoFactorPolicy {
  OFF
  /// Anyone holding an administrative role.
  ADMINS
  EVERYONE
}

/// Authentication policy for a tenant.
model TenantSecuritySetting {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  minPasswordLength    Int     @default(8)
  requireMixedCase     Boolean @default(true)
  requireNumber        Boolean @default(true)
  requireSymbol        Boolean @default(true)
  /// Days before a password must be changed; null never expires.
  passwordExpiryDays   Int?
  /// How many previous passwords cannot be reused.
  passwordHistoryCount Int     @default(3)

  maxFailedAttempts Int             @default(5)
  lockoutMinutes    Int             @default(15)
  sessionHours      Int             @default(8)
  twoFactorPolicy   TwoFactorPolicy @default(OFF)

  updatedAt DateTime @updatedAt

  @@map("tenant_security_settings")
}

/// Every sign-in attempt, successful or not. Drives lockout, rate limiting
/// and the security log administrators review.
model LoginEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  /// BAD_CREDENTIALS | LOCKED | RATE_LIMITED | DISABLED | OTP_SENT | OTP_FAILED | OK
  outcome   String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([tenantId, createdAt])
  @@map("login_events")
}

// ---------------------------------------------------------------------------
//  IDENTITY
// ---------------------------------------------------------------------------

enum AuthMethod {
  PASSWORD
  MOBILE_OTP
  MICROSOFT
  GOOGLE
}

enum TwoFactorMethod {
  NONE
  SMS
  EMAIL
}

/// A login. One-to-one with Employee once the employee is invited.
model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String?
  phone        String?

  /// Disable Login — "effect is immediate, with no delay or grace period".
  /// Distinct from deactivation and from exit (Teardown Part 05).
  loginDisabled      Boolean   @default(false)
  /// Consecutive failed sign-ins; reset on success.
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  /// Set by an administrator or an expired password.
  mustChangePassword Boolean   @default(false)
  /// Recent password hashes, newest first, to refuse reuse.
  passwordHistory    Json?
  /// Bumped to revoke every live session at once.
  sessionVersion     Int       @default(0)
  /// Temporary deactivation, e.g. sabbatical or extended leave.
  isDeactivated      Boolean   @default(false)

  twoFactor       TwoFactorMethod @default(NONE)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?

  employee Employee?

  sessions        Session[]
  roleAssignments UserRoleAssignment[]
  auditLogs       AuditLog[]

  // --- Keka parity: analytics storyboards (22-analytics) ---
  analyticsInsights     AnalyticsInsight[]
  analyticsComments     AnalyticsComment[]
  storyboardSharesOwned StoryboardShare[]  @relation("StoryboardShareOwner")
  storyboardShares      StoryboardShare[]  @relation("StoryboardShareRecipient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// One-time codes for mobile OTP login and 2FA.
model OtpChallenge {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identifier String // email or phone
  codeHash   String
  purpose    String // LOGIN | TWO_FACTOR
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, identifier])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
//  RBAC
// ---------------------------------------------------------------------------

/// Explicit, administratively assigned roles.
/// Eleven are seeded per tenant as system roles (Teardown Part 06);
/// custom roles are created by ticking individual privileges.
model Role {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Stable machine key, e.g. GLOBAL_ADMIN. Null for custom roles.
  key         String?
  name        String
  description String?
  /// System roles cannot be deleted and their key is fixed.
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// A single granted privilege, e.g. "payroll.run.execute".
/// The authoritative catalogue lives in @keka/rbac.
model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
  @@index([roleId])
  @@map("role_permissions")
}

/// A grant is (user x role x scope). Scope filters are department and location.
/// Legal entity is deliberately NOT available as a role scope filter —
/// this mirrors the documented gap (Teardown Part 06).
model UserRoleAssignment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  scopes RoleScope[]

  grantedAt DateTime @default(now())
  grantedBy String?
  /// Time-bound grant: revoked by the nightly job once past; ignored from then on.
  expiresAt DateTime?
  /// Why it was granted, e.g. "Access request" or "Temporary elevation".
  grantNote String?

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model RoleScope {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   UserRoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  departmentId String?
  locationId   String?

  @@index([assignmentId])
  @@map("role_scopes")
}

// ---------------------------------------------------------------------------
//  AUDIT
// ---------------------------------------------------------------------------

enum AuditModule {
  EMPLOYEE
  PAYROLL
  LEAVE
  ATTENDANCE
  ROLE
  AUTH
  FINANCE
  REPORT
  LIFECYCLE
  HELPDESK
  SYSTEM
  /// Org analytics, storyboards and attrition risk.
  ANALYTICS
  /// Asset inventory, assignments and requests.
  ASSET
  /// PSA: opportunities, project requests, resourcing and project billing.
  PROJECTS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOCK
  UNLOCK
  EXPORT
  LOGIN
  LOGOUT
  /// A read of sensitive data, e.g. the attrition-risk page.
  VIEW
}

/// Who, when, what, old value, new value.
/// Keka's own audit log covers four modules; this model covers those plus
/// role and auth changes, which the teardown flags as a real audit gap.
model AuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  module     AuditModule
  action     AuditAction
  entityType String
  entityId   String?
  /// Human-readable summary for the log list.
  summary    String?

  oldValue Json?
  newValue Json?

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([tenantId, module, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}
