// ============================================================================
//  KEKA — Base: generator, datasource, tenancy, identity, RBAC, audit
// ============================================================================
//  Tenancy model (ref: Teardown Part 07)
//    - Multi-tenant shared infrastructure with logical isolation.
//    - Every customer gets a subdomain: <subdomain>.keka.local
//    - Every tenant-scoped row carries tenantId and is indexed on it.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // multi-file schema (prisma/schema/) is GA as of Prisma 6.7
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
//  TENANT
// ---------------------------------------------------------------------------

enum PlanTier {
  FOUNDATION
  STRENGTH
  GROWTH
}

/// A customer account. Owns every other row in the system.
model Tenant {
  id        String   @id @default(cuid())
  /// Tenant address: <subdomain>.keka.local — also stamped on every webhook payload.
  subdomain String   @unique
  name      String
  /// Commercial tier. Gates features per the published matrix (Teardown Part 04).
  plan      PlanTier @default(FOUNDATION)
  /// Add-on product flags — neither can be bought standalone.
  hasHire   Boolean  @default(false)
  hasPsa    Boolean  @default(false)
  hasLearn  Boolean  @default(false)

  countryCode  String  @default("IN")
  currency     String  @default("INR")
  timezone     String  @default("Asia/Kolkata")
  /// Financial year start month, 1-12. India defaults to April.
  fyStartMonth Int     @default(4)
  logoUrl      String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Platform administration (25-platform-admin) ---
  /// Module keys (see @keka/rbac MODULES) the platform has switched off.
  disabledModules String[]  @default([])
  /// Why the company was suspended; shown on its sign-in page.
  suspendedReason String?
  suspendedAt     DateTime?
  /// Who to call about this account. Platform-only.
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  /// Licensed headcount; null means no limit. Shown against active employees.
  employeeLimit   Int?
  /// Free-text notes for the platform team.
  platformNotes   String?
  platformAuditLogs PlatformAuditLog[]

  users                User[]
  legalEntities        LegalEntity[]
