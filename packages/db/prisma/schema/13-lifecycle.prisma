// ============================================================================
//  KEKA — Lifecycle journeys, helpdesk, notifications and stored files
// ============================================================================
//  A journey is the set of things that must happen because something happened
//  to a person: they joined, resigned, were promoted, moved. Templates say what
//  those things are; a journey is one instance, anchored to a date, whose tasks
//  are due relative to it. HR stops remembering and starts reviewing.
// ============================================================================

enum JourneyTrigger {
  JOINING
  CONFIRMATION
  PROMOTION
  TRANSFER
  EXIT
  MANUAL
}

enum JourneyStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Who a task belongs to. Resolved to a person when the journey starts.
enum TaskOwner {
  HR
  MANAGER
  EMPLOYEE
  IT
  FINANCE
  ADMIN
}

enum JourneyTaskStatus {
  PENDING
  DONE
  SKIPPED
}

model JourneyTemplate {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  trigger      JourneyTrigger
  /// Narrow to a department or location; null applies to everyone.
  departmentId String?
  locationId   String?
  /// When several templates match a trigger, the most specific wins.
  isActive     Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks    JourneyTaskTemplate[]
  journeys Journey[]

  @@unique([tenantId, name])
  @@index([tenantId, trigger])
  @@map("journey_templates")
}

model JourneyTaskTemplate {
  id          String          @id @default(cuid())
  templateId  String
  template    JourneyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  owner       TaskOwner       @default(HR)
  /// Days relative to the journey's anchor date. Negative is before it.
  offsetDays  Int             @default(0)
  /// DOCUMENTS | ASSETS | ACCESS | TRAINING | MEETING | PAYROLL | COMPLIANCE | OTHER
  category    String          @default("OTHER")
  /// Must be done (not skipped) for the journey to complete.
  isRequired  Boolean         @default(true)
  /// A system check that marks the task done by itself, e.g. ASSETS_RETURNED.
  autoCheck   String?
  sortOrder   Int             @default(0)

  @@index([templateId])
  @@map("journey_task_templates")
}

model Journey {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId String?
  template   JourneyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  trigger    JourneyTrigger
  title      String
  /// Joining date, last working day, effective date of the change.
  anchorDate DateTime
  status     JourneyStatus  @default(ACTIVE)
  /// The record that caused it — an ExitRecord, a JobRecord.
  sourceType String?
  sourceId   String?

  createdBy   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  tasks JourneyTask[]

  @@unique([employeeId, trigger, anchorDate])
  @@index([tenantId, status])
  @@index([employeeId])
  @@map("journeys")
}

model JourneyTask {
  id                 String            @id @default(cuid())
  journeyId          String
  journey            Journey           @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  owner              TaskOwner
  /// The person the owner role resolved to, when one could be found.
  assigneeEmployeeId String?
  dueDate            DateTime
  category           String            @default("OTHER")
  isRequired         Boolean           @default(true)
  autoCheck          String?
  status             JourneyTaskStatus @default(PENDING)
  completedAt        DateTime?
  completedBy        String?
  note               String?
  sortOrder          Int               @default(0)

  @@index([journeyId])
  @@index([assigneeEmployeeId, status])
  @@map("journey_tasks")
}

// ---------------------------------------------------------------------------
//  HELPDESK
// ---------------------------------------------------------------------------

/// Keka parity: Keka's list is NA · Low · Medium · High. URGENT is legacy
/// (map it to HIGH); NA means "not set".
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  /// Keka "NA": no priority set.
  NA
}

/// Keka parity: Keka's statuses are Open · In Progress · On Hold · Closed.
/// WAITING_ON_EMPLOYEE (→ ON_HOLD) and RESOLVED (→ CLOSED) are legacy.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_EMPLOYEE
  RESOLVED
  CLOSED
  /// SLA clocks pause while ON_HOLD (see HelpdeskTicket.onHoldSince).
  ON_HOLD
}

enum HelpdeskAssignMode {
  /// The category head (defaultAssigneeUserId) gets every ticket.
  HEAD
  /// Rotate through HelpdeskCategoryAgent rows (cursor: lastAssignedUserId).
  ROUND_ROBIN
  UNASSIGNED
  /// The category agent with the fewest open tickets (33-cases-docs).
  LEAST_LOADED
}

model HelpdeskCategory {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  description           String?
  /// Resolution target, in business hours when businessHours is set.
  slaHours              Int      @default(48)
  /// UI label "Category head": owns escalations; assignee when assignMode = HEAD.
  defaultAssigneeUserId String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  // --- Keka parity (17-helpdesk-ops) ---
  /// First-response target, in business hours.
  firstResponseHours Int                    @default(8)
  /// Subcategories: a ticket is raised against a leaf.
  parentId           String?
  parent             HelpdeskCategory?      @relation("HelpdeskSubcategory", fields: [parentId], references: [id], onDelete: Cascade)
  children           HelpdeskCategory[]     @relation("HelpdeskSubcategory")
  /// Announcement.audience shape; null = everyone.
  /// { employeeIds: [], departmentIds: [], locationIds: [], businessUnitIds: [] }
  audience           Json?
  businessHoursId    String?
  businessHours      HelpdeskBusinessHours? @relation(fields: [businessHoursId], references: [id], onDelete: SetNull)
  enableOnHold       Boolean                @default(false)
  assignMode         HelpdeskAssignMode     @default(HEAD)
  /// Round-robin cursor.
  lastAssignedUserId String?
  defaultPriority    TicketPriority?
  sortOrder          Int                    @default(0)
  updatedAt          DateTime               @default(now()) @updatedAt

  tickets HelpdeskTicket[]
  agents  HelpdeskCategoryAgent[]

  /// Names stay unique per tenant across all levels (subcategories included).
  @@unique([tenantId, name])
  @@index([tenantId, parentId])
  @@map("helpdesk_categories")
}

model HelpdeskTicket {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Human-friendly, per tenant: HD-1042.
  number          Int
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  categoryId      String
  category        HelpdeskCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  subject         String
  description     String
  /// NA = Keka's "no priority". URGENT is legacy.
  priority        TicketPriority   @default(MEDIUM)
  status          TicketStatus     @default(OPEN)
  assigneeUserId  String?
  /// Resolution due.
  dueAt           DateTime
  firstResponseAt DateTime?
  /// Keka parity: set on close, cleared on reopen.
  resolvedAt      DateTime?
  closedAt        DateTime?
  /// 1–5, given by the employee on resolution.
  satisfaction    Int?

  // --- Keka parity: SLA, closing and followers (17-helpdesk-ops) ---
  firstResponseDueAt  DateTime?
  /// While ON_HOLD; on resume both dues shift by the business time held.
  onHoldSince         DateTime?
  missedFirstResponse Boolean                @default(false)
  missedResolution    Boolean                @default(false)
  closingReasonId     String?
  closingReason       HelpdeskClosingReason? @relation(fields: [closingReasonId], references: [id], onDelete: SetNull)
  closedByUserId      String?
  lastResponderUserId String?
  lastRespondedAt     DateTime?
  reopenCount         Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  HelpdeskComment[]
  followers HelpdeskTicketFollower[]

  // --- Case operations (33-cases-docs) ---
  /// S1 (critical) … S4 (minor), from triage rules or the agent.
  severity            String?
  /// WEB | EMAIL | PHONE | WALK_IN | CHAT — how the case reached HR.
  channel             String                     @default("WEB")
  /// Agent who logged it on the employee's behalf.
  loggedByUserId      String?
  mergedIntoId        String?
  splitFromId         String?
  escalationLevel     Int                        @default(0)
  lastEscalatedAt     DateTime?
  /// NONE | PENDING | APPROVED | REJECTED — a decision the case needs (policy exception…).
  approvalStatus      String                     @default("NONE")
  approvalRequestId   String?
  satisfactionComment String?
  articles            HelpdeskTicketArticle[]
  tasks               HelpdeskTicketTask[]
  escalations         HelpdeskTicketEscalation[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([employeeId])
  @@index([tenantId, categoryId])
  @@index([tenantId, assigneeUserId])
  @@map("helpdesk_tickets")
}

model HelpdeskComment {
  id           String         @id @default(cuid())
  ticketId     String
  ticket       HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String
  authorLabel  String
  body         String
  /// Visible to agents only (Keka "internal note").
  isInternal   Boolean        @default(false)
  /// System event line ("Status changed to On Hold", "First response was added…").
  isSystem     Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([ticketId])
  @@map("helpdesk_comments")
}

// ---------------------------------------------------------------------------
//  NOTIFICATIONS AND OUTBOUND EMAIL
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  body      String?
  /// Where clicking it goes.
  link      String?
  /// LEAVE | ATTENDANCE | PAYROLL | HELPDESK | JOURNEY | ...
  kind      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}

/// Email is written here in the same transaction as the change that caused
/// it, and delivered by a worker. A failed send never rolls back the change.
model EmailOutbox {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toAddress   String
  subject     String
  textBody    String
  htmlBody    String?
  status      OutboxStatus @default(QUEUED)
  attempts    Int          @default(0)
  lastError   String?
  relatedType String?
  relatedId   String?
  /// StoredFile ids sent as attachments (an F&F statement, for one).
  attachmentFileIds String[] @default([])
  createdAt   DateTime     @default(now())
  sentAt      DateTime?

  @@index([status, createdAt])
  @@map("email_outbox")
}

// ---------------------------------------------------------------------------
//  STORED FILES
// ---------------------------------------------------------------------------

/// An uploaded or generated file. Bytes live in object storage (or on disk in
/// development) under `storageKey`; this row is the index and the audit.
model StoredFile {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  sizeBytes   Int
  sha256      String
  storageKey  String   @unique
  /// What it is attached to: EmployeeDocument, HelpdeskTicket, Payslip...
  relatedType String?
  relatedId   String?
  /// The employee it concerns, for access checks.
  employeeId  String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([tenantId, relatedType, relatedId])
  @@index([employeeId])
  @@map("stored_files")
}

// ---------------------------------------------------------------------------
//  SCHEDULED JOBS
// ---------------------------------------------------------------------------

/// One execution of a scheduled job (scripts/jobs.ts), so operators can see
/// when mail last went out or accrual last ran — and whether it failed.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  summary    Json?
  error      String?

  @@index([job, startedAt])
  @@map("job_runs")
}
