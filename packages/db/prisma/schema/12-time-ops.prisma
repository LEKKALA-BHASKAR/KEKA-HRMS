// ============================================================================
//  KEKA — Time operations: attendance policy, assignment, requests, ledger
// ============================================================================
//  06-time holds the records. This file holds what drives them: the policy a
//  day is judged against, which policy each employee is on, the requests that
//  correct a day, and a ledger that makes every leave balance explainable.
// ============================================================================

/// Capture + penalisation rules, combined. A day's status, payable value and
/// loss of pay are computed against exactly one of these.
model AttendancePolicy {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?

  // --- Capture ---
  allowWebClockIn       Boolean @default(true)
  allowMobileClockIn    Boolean @default(true)
  /// Web clock-in only from these addresses. Empty means anywhere.
  ipAllowList           Json?
  requireClockInComment Boolean @default(false)

  // --- Day classification ---
  /// Effective hours at or above this share of the shift count as a full day.
  fullDayThresholdPct Int @default(90)
  /// At or above this share, a half day. Below it, absent.
  halfDayThresholdPct Int @default(50)

  // --- Late arrival ---
  graceMinutes       Int     @default(15)
  /// Late incidents per month forgiven before a penalty applies.
  lateExemptPerMonth Int     @default(3)
  /// Days of LOP per late incident beyond the exemption.
  latePenaltyDays    Decimal @default(0.5) @db.Decimal(4, 2)

  // --- Missing punch ---
  missingPunchExemptPerMonth Int     @default(2)
  missingPunchPenaltyDays    Decimal @default(0.5) @db.Decimal(4, 2)

  // --- No attendance ---
  /// A working day with no punches and no leave is loss of pay.
  noAttendanceIsLop Boolean @default(true)

  // --- Overtime ---
  overtimeEnabled    Boolean @default(false)
  /// Minutes beyond the shift before overtime starts counting.
  overtimeMinMinutes Int     @default(30)

  /// Days back an employee may request a regularisation.
  regularisationWindowDays Int @default(30)

  // --- Keka parity (time-inbox) ---
  allowRemoteClockIn         Boolean @default(false)
  remoteClockInNeedsApproval Boolean @default(true)
  /// Web and mobile punches must come from inside the work location's
  /// geo-fence (when the location has coordinates set).
  requireGeofence            Boolean @default(false)
  /// Every web, mobile or remote punch must carry a selfie.
  requireSelfie              Boolean @default(false)
  allowHalfDayRemoteWork     Boolean @default(true)
  allowHourlyRemoteWork      Boolean @default(false)
  overtimeNeedsRequest       Boolean @default(true)
  overtimeRequestWindowDays  Int     @default(30)
  allowShiftChangeRequests   Boolean @default(true)
  allowWeeklyOffRequests     Boolean @default(true)
  /// Days a penalty waits before applying, so the employee can regularise.
  penaltyBufferDays          Int     @default(2)

  // --- Policy depth ---
  /// Working a weekly off or holiday credits comp-off automatically when
  /// attendance is processed, instead of waiting for a request.
  autoCreditCompOff        Boolean @default(false)
  /// Overtime pay multipliers on the hourly rate.
  overtimeMultiplier       Decimal @default(1) @db.Decimal(4, 2)
  overtimeOffDayMultiplier Decimal @default(1) @db.Decimal(4, 2)
  /// Overtime minutes are rounded down to this block (0 = exact).
  overtimeRoundingMinutes  Int     @default(0)

  // --- Time & leave depth (26-time-leave-depth) ---
  /// EFFECTIVE (punched in-out pairs) or GROSS (first in to last out) hours
  /// judge the day against the full/half-day thresholds.
  hoursBasis                 String  @default("EFFECTIVE")
  /// Absent without leave: this many consecutive working days with no
  /// attendance and no leave are each marked absent and full loss of pay.
  awolEnabled                Boolean @default(false)
  awolAfterDays              Int     @default(3)
  /// The first days after joining carry no late or missing-punch penalties.
  newJoinerGraceDays         Int     @default(0)
  regularisationMonthlyLimit Int?
  /// Day of the next month after which a month's days can no longer be corrected.
  regularisationCutoffDay    Int?
  // Remote work (WFH / on duty)
  wfhMonthlyLimit            Int?
  odMonthlyLimit             Int?
  remoteNoticeDays           Int?
  remoteAllowedOnHolidays    Boolean @default(false)
  remoteAllowedOnWeeklyOffs  Boolean @default(false)
  remoteAttachmentRequired   Boolean @default(false)
  /// Approved overtime is credited as comp-off instead of being paid.
  overtimeToCompOff          Boolean @default(false)
  /// Overtime hours that make one day of comp-off.
  overtimeCompOffHoursPerDay Decimal @default(8) @db.Decimal(5, 2)

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments EmployeeTimePolicy[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("attendance_policies")
}

/// Which shift, weekly-off pattern, holiday calendar and attendance policy an
/// employee is on, effective-dated so a mid-month change is exact.
model EmployeeTimePolicy {
  id                 String            @id @default(cuid())
  employeeId         String
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendancePolicyId String?
  attendancePolicy   AttendancePolicy? @relation(fields: [attendancePolicyId], references: [id], onDelete: SetNull)
  shiftId            String?
  weeklyOffPolicyId  String?
  holidayCalendarId  String?
  /// Attendance is not tracked for this employee — no NO_ATTENDANCE LOP.
  trackAttendance    Boolean           @default(true)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([employeeId, effectiveFrom])
  @@map("employee_time_policies")
}

enum AttendanceRequestType {
  /// Add or correct punches for a day.
  ADJUSTMENT
  /// Ask for a penalty on a day to be waived.
  REGULARISATION
  /// Late arrival, early exit or a mid-day absence with permission.
  PARTIAL_DAY
  WORK_FROM_HOME
  ON_DUTY
  /// One per employee per day of Remote Clock-In punches awaiting approval.
  REMOTE_CLOCK_IN
}

enum AttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceRequest {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type           AttendanceRequestType
  status         AttendanceRequestStatus @default(PENDING)
  fromDate       DateTime
  toDate         DateTime
  /// For ADJUSTMENT: the corrected times, as UTC instants.
  proposedIn     DateTime?
  proposedOut    DateTime?
  /// For PARTIAL_DAY: minutes of permitted absence.
  partialMinutes Int?
  reason         String
  /// Ops depth: the regularisation reason code (OpsReasonCode, kind REGULARISATION).
  reasonCode     String?

  // --- Keka parity (time-inbox) ---
  /// WFH/OD: part of the day; null = full day.
  portion           DayPortion?
  /// WFH/OD by the hour: proposedIn/proposedOut carry the window.
  isHourly          Boolean     @default(false)
  /// ADJUSTMENT with several punches: [{ "at": "<ISO instant>", "direction": 0 | 1 }]
  proposedLogs      Json?
  /// Employees copied on the request: ["<employeeId>", ...]
  notifyEmployeeIds Json?
  attachmentFileId  String?

  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([employeeId, fromDate])
  @@map("attendance_requests")
}

enum LeaveLedgerKind {
  OPENING
  ACCRUAL
  USED
  /// A cancelled or rejected leave returning its days.
  REVERSAL
  ADJUSTMENT
  CARRY_FORWARD
  LAPSE
  ENCASHMENT
  COMP_OFF_CREDIT
}

/// Every movement on a leave balance. LeaveBalance is a cache of the sum;
/// this is the record that explains it.
model LeaveLedgerEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  yearStart   DateTime

  kind      LeaveLedgerKind
  /// Positive credits the balance, negative debits it.
  days      Decimal         @db.Decimal(9, 2)
  /// Idempotency key. An accrual for a given month carries "ACCRUAL:2026-06"
  /// so a re-run of the accrual job never double-credits.
  periodKey String?
  requestId String?
  note      String?
  /// COMP_OFF_CREDIT: the day this credit lapses.
  expiresOn DateTime?

  createdBy String?
  createdAt DateTime @default(now())

  @@unique([employeeId, leaveTypeId, kind, periodKey])
  @@index([employeeId, leaveTypeId, yearStart])
  @@index([requestId])
  @@map("leave_ledger_entries")
}
