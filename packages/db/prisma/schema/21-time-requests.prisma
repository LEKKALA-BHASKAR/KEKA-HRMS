// ============================================================================
//  KEKA — Time requests: shift / weekly-off changes, overtime, comp-off credit,
//  leave encashment, and the comment thread on any time request
// ============================================================================
//  Spec: time-inbox. There is no workflow model: "Next approver" is derived
//  (the reporting manager while PENDING, otherwise HR). The new requests reuse
//  the two existing status enums — AttendanceRequestStatus for the attendance
//  side, LeaveRequestStatus for the leave side — whose cancel and withdraw
//  semantics differ.
//  Field additions for the same spec are on AttendanceLog, LeaveType,
//  LeaveRequest, Shift (06-time) and AttendancePolicy, AttendanceRequest,
//  LeaveLedgerEntry (12-time-ops).
// ============================================================================

enum ShiftRequestKind {
  SHIFT_CHANGE
  WEEKLY_OFF
}

/// Keka's Shift Request and Weekly Off Request. Approval writes ShiftAssignment rows.
model ShiftRequest {
  id                String                  @id @default(cuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind              ShiftRequestKind
  status            AttendanceRequestStatus @default(PENDING)
  fromDate          DateTime
  toDate            DateTime
  /// SHIFT_CHANGE: the shift asked for.
  shiftId           String?
  shift             Shift?                  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  reason            String
  /// ["<employeeId>", ...]
  notifyEmployeeIds Json?

  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([employeeId, fromDate])
  @@map("shift_requests")
}

/// Overtime the employee claims; approval creates or extends the month's OvertimeEntry.
model OvertimeRequest {
  id                String                  @id @default(cuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status            AttendanceRequestStatus @default(PENDING)
  fromDate          DateTime
  toDate            DateTime
  /// The drawer's hh:mm, in minutes.
  requestedMinutes  Int
  /// Overtime the attendance logs showed when it was raised.
  loggedMinutes     Int                     @default(0)
  note              String?
  /// ["<employeeId>", ...]
  notifyEmployeeIds Json?

  decidedBy       String?
  decidedAt       DateTime?
  decisionNote    String?
  /// The OvertimeEntry an approval created or extended (plain id).
  overtimeEntryId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([employeeId, fromDate])
  @@map("overtime_requests")
}

/// "Request Credit for Compensatory Off". Approval writes a COMP_OFF_CREDIT ledger entry.
model CompOffRequest {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status           LeaveRequestStatus @default(PENDING)
  /// The days worked that earn the credit.
  fromDate         DateTime
  toDate           DateTime
  days             Decimal            @db.Decimal(9, 2)
  note             String?
  attachmentFileId String?

  decidedBy     String?
  decidedAt     DateTime?
  decisionNote  String?
  /// The LeaveLedgerEntry an approval wrote (plain id).
  ledgerEntryId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([employeeId, fromDate])
  @@map("comp_off_requests")
}

/// In-service leave encashment. Approval debits the ledger and raises a payroll payment.
model LeaveEncashmentRequest {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  yearStart   DateTime
  status      LeaveRequestStatus @default(PENDING)
  days        Decimal            @db.Decimal(9, 2)
  encashAll   Boolean            @default(false)
  /// Estimated from the type's formula when raised; fixed on approval.
  amount      Decimal?           @db.Decimal(18, 2)
  note        String?

  decidedBy          String?
  decidedAt          DateTime?
  decisionNote       String?
  /// AdhocTransaction (sourceType "LeaveEncashmentRequest") an approval raised.
  adhocTransactionId String?
  /// Employee who raised it on the employee's behalf (HR or manager).
  requestedBy        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([employeeId, yearStart])
  @@index([leaveTypeId])
  @@map("leave_encashment_requests")
}

/// The 💬 thread on any time request, and the inbox's comment box.
model RequestComment {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// LeaveRequest | AttendanceRequest | ShiftRequest | OvertimeRequest | CompOffRequest | LeaveEncashmentRequest
  entityType       String
  entityId         String
  authorEmployeeId String?
  authorUserId     String?
  body             String
  createdAt        DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("request_comments")
}
