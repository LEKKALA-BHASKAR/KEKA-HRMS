// ============================================================================
//  KEKA — Projects: clients, projects, tasks, milestones, timesheets
// ============================================================================
//  PeoplePro and HRM OS both ship project management. The shape here covers
//  task allocation, progress tracking, milestone management and resource
//  allocation, plus the timesheet layer that bridges projects to payroll.
// ============================================================================

model Client {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name             String
  code             String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  addressLine1     String?
  city             String?
  state            String?
  countryCode      String  @default("IN")
  gstin            String?
  currency         String  @default("INR")
  /// Owning account manager.
  accountManagerId String?
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  rateCards RateCard[]
  invoices  Invoice[]

  // --- Keka parity: PSA (20-psa-ops) ---
  /// Prospects converted into (or linked to) this client.
  prospects       Prospect[]
  opportunities   Opportunity[]
  projectRequests ProjectRequest[]
  creditNotes     CreditNote[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("clients")
}

enum BillingModel {
  /// Invoiced on hours logged, priced from the rate card.
  TIME_AND_MATERIAL
  /// Billed against milestones rather than hours. Displayed as "Fixed fee".
  MILESTONE
  /// A fixed amount at a set frequency, independent of timesheets.
  RETAINER
  /// Internal work: training, R&D, bench.
  NON_BILLABLE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  OVERDUE
}

enum ProjectHealth {
  GREEN
  AMBER
  RED
}

model Project {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name         String
  code         String?
  description  String?
  billingModel BillingModel  @default(TIME_AND_MATERIAL)
  status       ProjectStatus @default(PLANNING)
  health       ProjectHealth @default(GREEN)

  startDate      DateTime?
  endDate        DateTime?
  /// Estimated effort, for variance reporting.
  estimatedHours Decimal?  @db.Decimal(12, 2)
  budget         Decimal?  @db.Decimal(18, 2)
  currency       String    @default("INR")

  /// Retainer configuration, used when billingModel is RETAINER.
  retainerFee       Decimal?  @db.Decimal(18, 2)
  /// DAILY | WEEKLY | BI_WEEKLY | MONTHLY
  retainerFrequency String?
  retainerFrom      DateTime?

  projectManagerId         String?
  projectManager           Employee? @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  /// Timesheet approval can be switched off per project.
  requireTimesheetApproval Boolean   @default(true)
  /// Ordered approver employee ids or role ids.
  approverIds              Json?
  costCenterId             String?

  // --- Keka parity: PSA (20-psa-ops) ---
  /// The won opportunity this project came from.
  opportunityId      String?            @unique
  opportunity        Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  revenueRecognition RevenueRecognition @default(INCOME_TO_DATE)
  rateCardId         String?
  rateCard           RateCard?          @relation(fields: [rateCardId], references: [id], onDelete: SetNull)
  /// Org-unit ids are plain columns, like costCenterId.
  businessUnitId     String?
  departmentId       String?
  locationId         String?
  priority           String?
  csat               String?
  tags               String[]           @default([])
  archivedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases           ProjectPhase[]
  milestones       Milestone[]
  tasks            Task[]
  allocations      ResourceAllocation[]
  timeEntries      TimeEntry[]
  invoices         Invoice[]
  /// PSA (20-psa-ops).
  request          ProjectRequest?
  charges          ProjectCharge[]
  resourceRequests ResourceRequest[]
  /// Praise tagged with this project (15-engage).
  praises          Praise[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([clientId])
  @@map("projects")
}

model ProjectPhase {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  sequence  Int       @default(0)
  startDate DateTime?
  endDate   DateTime?

  tasks Task[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_phases")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  INVOICED
}

model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  dueDate     DateTime
  completedOn DateTime?
  status      MilestoneStatus @default(PENDING)
  /// Amount billable on completion, for MILESTONE billing.
  amount      Decimal?        @db.Decimal(18, 2)
  /// Share of overall project progress this milestone represents.
  weight      Decimal         @default(0) @db.Decimal(9, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@map("milestones")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId     String?
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestoneId String?

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assigneeId String?
  assignee   Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId String?

  estimatedHours  Decimal? @db.Decimal(12, 2)
  /// Rolled up from time entries.
  loggedHours     Decimal  @default(0) @db.Decimal(12, 2)
  progressPercent Int      @default(0)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  /// Billable tasks contribute to invoiced hours.
  isBillable  Boolean   @default(true)

  /// Parent for a subtask hierarchy.
  parentTaskId String?
  parentTask   Task?   @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]  @relation("Subtasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]
  comments    TaskComment[]

  @@index([tenantId, status])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// Rate cards carry two figures per role, which is what makes margin native.
model RateCard {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Null for an organisation-wide reference card.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name     String
  currency String  @default("INR")
  isActive Boolean @default(true)
  /// The unit billRate/suggestedCost are quoted in; HOURLY today.
  rateUnit String  @default("HOURLY")

  createdAt DateTime @default(now())

  rates     BillingRate[]
  /// PSA (20-psa-ops).
  projects  Project[]
  estimates OpportunityEstimate[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([clientId])
  @@map("rate_cards")
}

model BillingRate {
  id         String   @id @default(cuid())
  rateCardId String
  rateCard   RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  /// Billing role, e.g. "Senior Developer".
  billingRole   String
  /// Rate category, e.g. onsite vs offsite.
  rateCategory  String   @default("STANDARD")
  /// What the client is charged per hour.
  billRate      Decimal  @db.Decimal(18, 2)
  /// What the resource costs per hour. billRate - suggestedCost = margin.
  suggestedCost Decimal? @db.Decimal(18, 2)

  effectiveFrom DateTime?

  @@unique([rateCardId, billingRole, rateCategory])
  @@index([rateCardId])
  @@map("billing_rates")
}

model ResourceAllocation {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation("ProjectAllocation", fields: [employeeId], references: [id], onDelete: Cascade)

  billingRole       String?
  /// Percentage of the employee's capacity on this project.
  allocationPercent Decimal  @default(100) @db.Decimal(9, 2)
  billRate          Decimal? @db.Decimal(18, 2)
  costRate          Decimal? @db.Decimal(18, 2)
  isBillable        Boolean  @default(true)

  startDate DateTime
  endDate   DateTime?

  /// A junior supporting a senior. Shadow hours bill at the primary's rate.
  shadowOfEmployeeId String?

  // --- Keka parity: PSA resourcing (20-psa-ops) ---
  /// SOFT = tentative (warn only); HARD = booked (≤100 % rule).
  kind      AllocationKind @default(HARD)
  /// The ResourceRequest this allocation fulfils (plain id).
  requestId String?

  createdAt DateTime @default(now())

  @@unique([projectId, employeeId, startDate])
  @@index([employeeId, startDate])
  @@index([projectId])
  @@index([requestId])
  @@map("resource_allocations")
}

enum AllocationKind {
  SOFT
  HARD
}

/// How a project's revenue is recognised to date.
enum RevenueRecognition {
  INCOME_TO_DATE
  INVOICED_AMOUNT
  COST_TO_COST
  TIME_EXPENDED
}

enum InvoiceKind {
  TAX
  PROFORMA
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  /// Locked once invoiced, so hours cannot shift under a raised invoice.
  LOCKED
}

/// One weekly timesheet per employee. Monday to Sunday is the standard period.
model Timesheet {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation("EmployeeTimesheet", fields: [employeeId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  status      TimesheetStatus @default(DRAFT)

  totalHours    Decimal @default(0) @db.Decimal(12, 2)
  billableHours Decimal @default(0) @db.Decimal(12, 2)

  submittedAt  DateTime?
  approvedBy   String?
  approvedAt   DateTime?
  rejectReason String?
  /// User who sent it back, and when.
  rejectedBy   String?
  rejectedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TimeEntry[]

  @@unique([employeeId, periodStart])
  @@index([tenantId, status])
  @@map("timesheets")
}

model TimeEntry {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timesheetId String?
  timesheet   Timesheet? @relation(fields: [timesheetId], references: [id], onDelete: SetNull)
  employeeId  String
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  date        DateTime
  hours       Decimal  @db.Decimal(9, 2)
  description String?
  isBillable  Boolean  @default(true)
  /// Rate captured at entry time, so a later rate-card change does not
  /// retroactively alter what was billed.
  billRate    Decimal? @db.Decimal(18, 2)
  costRate    Decimal? @db.Decimal(18, 2)

  /// Set once the hours appear on an invoice.
  invoiceId  String?
  isInvoiced Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, date])
  @@index([employeeId, date])
  @@index([projectId, date])
  @@index([timesheetId])
  @@map("time_entries")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WRITTEN_OFF
}

model Invoice {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("INR")

  issueDate   DateTime
  dueDate     DateTime
  periodStart DateTime?
  periodEnd   DateTime?

  subtotal   Decimal @default(0) @db.Decimal(18, 2)
  taxTotal   Decimal @default(0) @db.Decimal(18, 2)
  discount   Decimal @default(0) @db.Decimal(18, 2)
  total      Decimal @default(0) @db.Decimal(18, 2)
  amountPaid Decimal @default(0) @db.Decimal(18, 2)
  amountDue  Decimal @default(0) @db.Decimal(18, 2)

  notes   String?
  terms   String?
  /// The rendered invoice, as a /files link.
  fileUrl String?
  sentAt  DateTime?

  // --- Keka parity: PSA billing (20-psa-ops) ---
  kind            InvoiceKind @default(TAX)
  documentTitle   String      @default("Tax Invoice")
  /// LegalEntity id whose BillingEntitySetting numbers and heads this invoice.
  billingEntityId String?
  poNumber        String?
  paymentTermDays Int         @default(30)
  attentionName   String?
  attentionEmail  String?
  /// The PROFORMA this TAX invoice was converted from (plain id).
  convertedFromId String?
  writtenOffAt    DateTime?
  writeOffAmount  Decimal?    @db.Decimal(18, 2)
  writeOffReason  String?
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       InvoiceLine[]
  payments    InvoicePayment[]
  charges     ProjectCharge[]
  creditNotes CreditNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  /// HOURS | MILESTONE | RETAINER | EXPENSE | PRODUCT
  lineType    String  @default("HOURS")
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitRate    Decimal @default(0) @db.Decimal(18, 2)
  taxPercent  Decimal @default(0) @db.Decimal(9, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)

  milestoneId String?
  sequence    Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model InvoicePayment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount       Decimal  @db.Decimal(18, 2)
  paidOn       DateTime
  /// BANK_TRANSFER | CHEQUE | CASH | CARD | UPI
  method       String   @default("BANK_TRANSFER")
  reference    String?
  notes        String?
  /// A credit note rather than a receipt.
  isCreditNote Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_payments")
}
