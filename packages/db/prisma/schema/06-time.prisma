// ============================================================================
//  KEKA — Leave and attendance
// ============================================================================
//  Payroll step 1 consumes this module: approved leave, no-attendance days,
//  system-calculated LOP, LOP reversals and payable units all originate here.
//
//  Exactly three documented drivers of loss of pay:
//    1. an unpaid-leave request (automatic)
//    2. a penalisation policy set to "consider all penalties as LOP"
//    3. a manual LOP override, per employee or by bulk import
// ============================================================================

enum LeaveCategory {
  /// Annual, earned, sick and casual are all modelled here.
  REGULAR
  /// Event-triggered, e.g. maternity.
  INCIDENT
  COMP_OFF
  /// The only type that adds directly to payroll LOP with no policy between.
  UNPAID
  /// Backs optional/floating holidays.
  FLOATER
}

enum AccrualFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  /// Whole quota available immediately rather than accrued.
  UPFRONT
}

enum LeaveUnit {
  DAYS
  HOURS
}

enum YearEndAction {
  RESET
  PAY_ALL
  CARRY_FORWARD_ALL
  PAY_THEN_CARRY_FORWARD
  CARRY_FORWARD_THEN_PAY
}

model LeaveType {
  id       String        @id @default(cuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  code     String
  category LeaveCategory @default(REGULAR)
  unit     LeaveUnit     @default(DAYS)
  color    String?

  /// Paid leave does not create LOP; unpaid leave does.
  isPaid Boolean @default(true)

  // --- Accrual ---
  accrualFrequency AccrualFrequency @default(MONTHLY)
  /// Day of the period on which the credit lands.
  accrualDay       Int              @default(1)
  annualQuota      Decimal          @default(0) @db.Decimal(9, 2)
  /// Each period may carry its own value, including zero.
  unevenAccrual    Json?
  isUnlimited      Boolean          @default(false)

  // --- On joining ---
  prorateOnJoining      Boolean @default(true)
  /// No leave awarded if the employee joins after this day of the month.
  noAwardIfJoinAfterDay Int?

  // --- Probation ---
  accrueDuringProbation  Boolean  @default(true)
  probationWaitDays      Int?
  maxDaysDuringProbation Decimal? @db.Decimal(9, 2)

  // --- On exit ---
  prorateOnExit             Boolean  @default(true)
  accrueDuringNotice        Boolean  @default(true)
  /// Leave taken during notice extends the notice period by this multiplier.
  noticeExtensionMultiplier Decimal? @db.Decimal(9, 2)

  // --- Stop conditions ---
  expiryDaysAfterCredit Int?
  maxAccumulation       Decimal? @db.Decimal(9, 2)

  // --- Negative balance ---
  allowNegativeBalance Boolean  @default(false)
  maxNegativeDays      Decimal? @db.Decimal(9, 2)

  // --- Application rules ---
  allowHalfDay            Boolean  @default(true)
  allowQuarterDay         Boolean  @default(false)
  allowBackdated          Boolean  @default(true)
  priorNoticeDays         Int?
  requireComment          Boolean  @default(false)
  attachmentAboveDays     Decimal? @db.Decimal(9, 2)
  /// Hidden from employees — admin or manager applied only.
  isHiddenFromEmployee    Boolean  @default(false)
  maxConsecutiveDays      Decimal? @db.Decimal(9, 2)
  maxDaysPerMonth         Decimal? @db.Decimal(9, 2)
  minGapBetweenLeavesDays Int?

  // --- Sandwich rules ---
  /// Five independent weekly-off triggers and five holiday triggers.
  /// { weeklyOff: { between, before, after, eitherSide, dayBetweenLeaves },
  ///   holiday:   { ... }, threshold, excludeHalfDay, clubAcrossLeaveTypes }
  sandwichConfig Json?

  // --- Year end ---
  yearEndAction          YearEndAction @default(CARRY_FORWARD_ALL)
  carryForwardMax        Decimal?      @db.Decimal(9, 2)
  carryForwardExpiryDays Int?
  encashmentEnabled      Boolean       @default(false)
  /// Formula linking encashment to salary components, e.g. "[BASIC] / 30".
  encashmentFormula      String?

  // --- Keka parity (time-inbox) ---
  /// Shown in the leave drawer and policy explanation.
  description              String?
  /// COMP_OFF: days after the worked day within which credit may be requested.
  compOffRequestWindowDays Int?
  /// Employees may request encashment in service.
  allowEncashmentRequest   Boolean  @default(false)
  encashmentMaxDaysPerYear Decimal? @db.Decimal(9, 2)

  // --- Policy depth: approvals ---
  /// Approval chain for this type, overriding the plan's. Null falls back to
  /// the plan, then to a single decision by anyone allowed to approve.
  /// { "levels": ["REPORTING_MANAGER", "HR"], "skipSamePerson": true, "autoApproveAfterDays": 3 }
  approvalChain Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planLinks          LeavePlanType[]
  balances           LeaveBalance[]
  requests           LeaveRequest[]
  encashmentRequests LeaveEncashmentRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

enum LeaveYearBasis {
  CALENDAR_JAN
  FINANCIAL_APR
  /// Aligned to each employee's work anniversary.
  JOINING_DATE
}

model LeavePlan {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  yearBasis     LeaveYearBasis @default(FINANCIAL_APR)
  isDefault     Boolean        @default(false)
  isActive      Boolean        @default(true)
  /// Default approval chain for every type in the plan (same shape as LeaveType.approvalChain).
  approvalChain Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  types       LeavePlanType[]
  assignments LeavePlanAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("leave_plans")
}

model LeavePlanType {
  id            String    @id @default(cuid())
  planId        String
  plan          LeavePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  /// Overrides the leave type's default quota for this plan.
  quotaOverride Decimal?  @db.Decimal(9, 2)

  @@unique([planId, leaveTypeId])
  @@index([planId])
  @@map("leave_plan_types")
}

model LeavePlanAssignment {
  id            String    @id @default(cuid())
  planId        String
  plan          LeavePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  employeeId    String
  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@unique([planId, employeeId, effectiveFrom])
  @@index([employeeId])
  @@map("leave_plan_assignments")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  /// Leave year this balance belongs to.
  yearStart      DateTime
  opening        Decimal  @default(0) @db.Decimal(9, 2)
  accrued        Decimal  @default(0) @db.Decimal(9, 2)
  used           Decimal  @default(0) @db.Decimal(9, 2)
  encashed       Decimal  @default(0) @db.Decimal(9, 2)
  lapsed         Decimal  @default(0) @db.Decimal(9, 2)
  carriedForward Decimal  @default(0) @db.Decimal(9, 2)
  /// opening + accrued + carriedForward - used - encashed - lapsed
  available      Decimal  @default(0) @db.Decimal(9, 2)

  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, yearStart])
  @@index([employeeId])
  @@map("leave_balances")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum DayPortion {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
  QUARTER
}

model LeaveRequest {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  fromDate     DateTime
  toDate       DateTime
  fromPortion  DayPortion @default(FULL_DAY)
  toPortion    DayPortion @default(FULL_DAY)
  /// Net days after portions and sandwich rules.
  totalDays    Decimal    @db.Decimal(9, 2)
  /// Extra days added purely by the sandwich rule.
  sandwichDays Decimal    @default(0) @db.Decimal(9, 2)

  reason        String?
  attachmentUrl String?
  status        LeaveRequestStatus @default(PENDING)

  approvedBy        String?
  approvedAt        DateTime?
  rejectReason      String?
  /// Employee who raised it, when an administrator applied on someone's behalf.
  requestedBy       String?
  /// Employee who cancelled or withdrew it, and when.
  cancelledBy       String?
  cancelledAt       DateTime?
  /// Employees copied on the request (Keka "Notify"): ["<employeeId>", ...]
  notifyEmployeeIds Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days LeaveRequestDay[]

  /// The approval chain resolved when the request was raised, one entry per
  /// level: [{ role, approverId, status, by, at, note }]. Null = single decision.
  approvalSteps Json?
  /// Index into approvalSteps of the level awaiting a decision.
  approvalLevel Int       @default(0)
  /// When the current level started waiting (drives auto-approval).
  levelSince    DateTime?

  @@index([tenantId, employeeId, fromDate])
  @@index([status])
  @@map("leave_requests")
}

/// Exploded per-day rows so payroll can intersect a request with a pay period.
model LeaveRequestDay {
  id         String       @id @default(cuid())
  requestId  String
  request    LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  date       DateTime
  portion    DayPortion   @default(FULL_DAY)
  /// 1.0, 0.5 or 0.25.
  dayValue   Decimal      @db.Decimal(9, 2)
  isSandwich Boolean      @default(false)
  isPaid     Boolean      @default(true)

  @@unique([requestId, date])
  @@index([date])
  @@map("leave_request_days")
}

// ---------------------------------------------------------------------------
//  HOLIDAYS
// ---------------------------------------------------------------------------

model HolidayCalendar {
  id                   String  @id @default(cuid())
  tenantId             String
  tenant               Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  year                 Int
  /// Locations this calendar applies to.
  locationIds          Json?
  isDefault            Boolean @default(false)
  /// Optional (restricted) holidays each employee may pick from this calendar.
  optionalHolidayQuota Int     @default(0)

  createdAt DateTime  @default(now())
  holidays  Holiday[]

  @@unique([tenantId, name, year])
  @@index([tenantId])
  @@map("holiday_calendars")
}

model Holiday {
  id          String          @id @default(cuid())
  calendarId  String
  calendar    HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime
  /// Optional/floating holidays are drawn against a floater leave type.
  isOptional  Boolean         @default(false)
  description String?

  selections OptionalHolidaySelection[]

  @@unique([calendarId, date, name])
  @@index([calendarId, date])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
//  SHIFTS AND ATTENDANCE
// ---------------------------------------------------------------------------

model Shift {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  /// Used as the key for Excel roster import.
  code            String
  startTime       String
  endTime         String
  /// Flexible shifts count total hours rather than fixed in/out times.
  isFlexible      Boolean  @default(false)
  /// Required hours for a flexible shift.
  requiredHours   Decimal? @db.Decimal(9, 2)
  breakMinutes    Int      @default(60)
  /// Auto clock-out after this many minutes in a single slot.
  maxSlotMinutes  Int?
  /// Per-day overrides so a shift can differ Mon-Sun.
  daySchedule     Json?
  /// The shift ends on the following calendar day.
  crossesMidnight Boolean  @default(false)
  color           String?
  /// Shift allowance earned per day worked on this shift (pay code + rate).
  allowanceCode   String?
  allowancePerDay Decimal? @db.Decimal(18, 2)
  isActive        Boolean  @default(true)

  createdAt   DateTime          @default(now())
  assignments ShiftAssignment[]
  /// SHIFT_CHANGE requests asking for this shift (21-time-requests).
  requests    ShiftRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("shifts")
}

model ShiftAssignment {
  id            String   @id @default(cuid())
  employeeId    String
  shiftId       String
  shift         Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date          DateTime
  /// WO = full day off, WOF = first half, WOS = second half, ON = a working
  /// day even where the weekly-off pattern says off.
  weeklyOffCode String?

  @@unique([employeeId, date])
  @@index([shiftId, date])
  @@map("shift_assignments")
}

/// A repeating sequence of days for rostering rotating shifts, e.g. five
/// mornings, two off, five nights, two off. Each step is a shift id, or null
/// with off=true for a weekly off. Applying it writes ShiftAssignment rows.
model RosterPattern {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// [{ "shiftId": "...", "off": false }, { "shiftId": null, "off": true }, ...]
  steps     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roster_patterns")
}

model WeeklyOffPolicy {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// Per-weekday instance rules — the primitive behind alternate-Saturday
  /// and nth-week patterns.
  /// { "SAT": { instances: [2, 4], portion: "FULL_DAY" }, "SUN": { instances: "ALL" } }
  config    Json
  isDefault Boolean @default(false)
  version   Int     @default(1)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([tenantId, name, version])
  @@index([tenantId])
  @@map("weekly_off_policies")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
  ON_DUTY
  WORK_FROM_HOME
  /// No punch recorded and no leave applied.
  NO_ATTENDANCE
}

enum CaptureSource {
  WEB
  MOBILE
  BIOMETRIC
  KIOSK
  API
  MANUAL
  /// Remote Clock-In — held for approval when the policy says so.
  REMOTE
}

enum PunchStatus {
  /// Counts toward the day.
  VALID
  /// A remote punch awaiting approval; processing ignores it.
  PENDING
  /// Rejected remote punch, kept for the audit trail, never counted.
  REJECTED
}

/// One row per employee per day. This is what payroll step 1 reads.
model AttendanceRecord {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  date       DateTime

  status         AttendanceStatus @default(NO_ATTENDANCE)
  shiftId        String?
  firstIn        DateTime?
  lastOut        DateTime?
  /// Total time between first in and last out.
  grossHours     Decimal          @default(0) @db.Decimal(9, 2)
  /// Gross minus breaks.
  effectiveHours Decimal          @default(0) @db.Decimal(9, 2)
  overtimeHours  Decimal          @default(0) @db.Decimal(9, 2)

  /// Payable fraction of the day: 1.0, 0.5 or 0.
  payableValue  Decimal @default(1) @db.Decimal(9, 2)
  /// LOP contribution from this day.
  lopValue      Decimal @default(0) @db.Decimal(9, 2)
  /// Set when a penalisation policy produced the LOP.
  penaltyReason String?

  isRegularised Boolean @default(false)
  remark        String?

  /// An administrator's override of the day's status; processing keeps it.
  manualStatus AttendanceStatus?
  editedBy     String?
  editedAt     DateTime?
  editReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs AttendanceLog[]

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

/// Raw punches. Ingested from devices or the attendance API.
model AttendanceLog {
  id       String            @id @default(cuid())
  recordId String?
  record   AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  tenantId String

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId          String
  timestamp           DateTime
  /// 0 = IN, 1 = OUT.
  direction           Int
  source              CaptureSource @default(WEB)
  deviceId            String?
  latitude            Decimal?      @db.Decimal(10, 7)
  longitude           Decimal?      @db.Decimal(10, 7)
  ipAddress           String?
  selfieUrl           String?
  comment             String?
  /// Only VALID punches count toward the day.
  status              PunchStatus   @default(VALID)
  /// The REMOTE_CLOCK_IN AttendanceRequest this punch belongs to.
  attendanceRequestId String?

  createdAt DateTime @default(now())

  @@index([tenantId, employeeId, timestamp])
  @@index([recordId])
  @@index([attendanceRequestId])
  @@map("attendance_logs")
}

/// Manual LOP override — the third documented LOP driver.
/// Also carries LOP reversals from previous months.
model LopAdjustment {
  id               String  @id @default(cuid())
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String
  /// Pay period the adjustment applies to.
  year             Int
  month            Int
  /// Positive adds LOP days, negative reverses them.
  days             Decimal @db.Decimal(9, 2)
  /// The month the reversed LOP originally fell in.
  reversalForYear  Int?
  reversalForMonth Int?
  /// For a reversal carried from a closed month: its value at that month's
  /// day rate, paid as arrears.
  amount           Decimal? @db.Decimal(18, 2)
  note             String?
  runId            String?
  /// MANUAL (run screen) | IMPORT (CSV of LOP days per employee per month)
  source           String  @default("MANUAL")

  createdAt DateTime @default(now())
  createdBy String?

  @@index([tenantId, employeeId, year, month])
  @@map("lop_adjustments")
}

/// Overtime recorded for a pay period, priced by the OT pay code.
model OvertimeEntry {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  year        Int
  month       Int
  hours       Decimal @db.Decimal(9, 2)
  /// Rate per hour, typically annual basic / 2920.
  rate        Decimal @db.Decimal(18, 4)
  amount      Decimal @db.Decimal(18, 2)
  /// PAY | VOID | PAID_OUTSIDE
  payAction   String  @default("PAY")
  runId       String?
  isProcessed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId, employeeId, year, month])
  @@map("overtime_entries")
}

/// Shift allowance earned in a pay period.
model ShiftAllowanceEntry {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  year          Int
  month         Int
  shiftCode     String?
  /// The shift's allowance pay code when generated from attendance.
  allowanceCode String?
  days          Decimal @default(0) @db.Decimal(9, 2)
  amount        Decimal @db.Decimal(18, 2)
  /// Created by the attendance step; regenerated rows replace these until paid.
  isGenerated   Boolean @default(false)
  /// PAY | HOLD | VOID | PAID_OUTSIDE
  payAction     String  @default("PAY")
  runId         String?
  isProcessed   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId, employeeId, year, month])
  @@map("shift_allowance_entries")
}
